{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types"],
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "db/**/*.ts",
    "drizzle.config.ts",
    "test/worker-fixture.ts",
    "test/*-worker.ts"
  ]
}
