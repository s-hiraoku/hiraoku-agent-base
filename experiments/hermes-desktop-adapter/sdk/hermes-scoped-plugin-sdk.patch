+import { render, screen } from '@testing-library/react'
+import { atom } from 'nanostores'
+import { expect, it, vi } from 'vitest'
+
+import { ChatRuntimeBoundary } from '@/app/chat'
+import { PRIMARY_SESSION_VIEW, SessionViewProvider } from '@/app/chat/session-view'
+import { stubThreadEnvironment } from '@/components/assistant-ui/test-utils'
+import { registry } from '@/contrib/registry'
+import { $activeGatewayProfile } from '@/store/profile'
+import { $connection, _resetSessionOwnerHintsForTests, setSessionOwnerHint } from '@/store/session'
+
+import { ComposerContributionSlot, usePluginComposerContext } from './composer-context'
+
+stubThreadEnvironment()
+
+function Probe() {
+  return <output>{JSON.stringify(usePluginComposerContext())}</output>
+}
+
+it('the real main-chat runtime publishes its saved local-lab owner to contribution slots', () => {
+  _resetSessionOwnerHintsForTests({ storage: true })
+  $connection.set({ mode: 'local', connectionId: 'local' } as never)
+  $activeGatewayProfile.set('local-lab')
+  setSessionOwnerHint('saved-main', { connectionId: 'local', profile: 'local-lab' })
+  const dispose = registry.register({ id: 'main-probe', area: 'composer.top', render: () => <Probe /> })
+
+  const view = {
+    ...PRIMARY_SESSION_VIEW,
+    $messages: atom([]),
+    $runtimeId: atom<string | null>('runtime'),
+    $storedId: atom<string | null>('saved-main')
+  }
+
+  const rendered = render(
+    <SessionViewProvider value={view}>
+      <ChatRuntimeBoundary
+        busy={false}
+        onCancel={vi.fn()}
+        onEdit={vi.fn()}
+        onReload={vi.fn()}
+        onThreadMessagesChange={vi.fn()}
+        suppressMessages={false}
+      >
+        <ComposerContributionSlot area="composer.top" />
+      </ChatRuntimeBoundary>
+    </SessionViewProvider>
+  )
+
+  expect(JSON.parse(screen.getByRole('status').textContent!)).toEqual({
+    storedSessionId: 'saved-main',
+    connectionId: 'local',
+    profile: 'local-lab',
+    visible: true
+  })
+  rendered.unmount()
+  dispose()
+  _resetSessionOwnerHintsForTests({ storage: true })
+  $connection.set(null)
+  $activeGatewayProfile.set('default')
+})
diff --git a/apps/desktop/src/sdk/composer-context.test.tsx b/apps/desktop/src/sdk/composer-context.test.tsx
