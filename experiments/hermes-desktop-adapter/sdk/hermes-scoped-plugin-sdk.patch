@@ -0,0 +1,41 @@
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { setApiRequestConnection, setApiRequestProfile } from './client'
+import { pluginRest } from './plugins'
+
+afterEach(() => {
+  setApiRequestConnection(null)
+  setApiRequestProfile(null)
+  Reflect.deleteProperty(window, 'hermesDesktop')
+})
+it('pins explicit owner for reads and writes despite an unrelated ambient gateway', async () => {
+  const api = vi.fn().mockResolvedValue({ ok: true })
+  Object.defineProperty(window, 'hermesDesktop', { configurable: true, value: { api } })
+  setApiRequestConnection('ambient')
+  setApiRequestProfile('other')
+  await pluginRest('fixture', '/binding', { owner: { connectionId: 'bound', profile: 'work' } })
+  await pluginRest('fixture', '/decision', {
+    owner: { connectionId: 'bound', profile: 'work' },
+    method: 'POST',
+    body: { decision: 'later' }
+  })
+  expect(api).toHaveBeenNthCalledWith(
+    1,
+    expect.objectContaining({ path: '/api/plugins/fixture/binding', connectionId: 'bound', profile: 'work' })
+  )
+  expect(api).toHaveBeenNthCalledWith(
+    2,
+    expect.objectContaining({ connectionId: 'bound', profile: 'work', method: 'POST' })
+  )
+})
+it('rejects incomplete explicit owners before transport, keeps omitted-owner compatibility', async () => {
+  const api = vi.fn().mockResolvedValue({ ok: true })
+  Object.defineProperty(window, 'hermesDesktop', { configurable: true, value: { api } })
+  setApiRequestProfile('legacy')
+  await expect(pluginRest('fixture', '/binding', { owner: { connectionId: '', profile: 'work' } })).rejects.toThrow(
+    'owner requires'
+  )
+  expect(api).not.toHaveBeenCalled()
+  await pluginRest('fixture', '/binding')
+  expect(api).toHaveBeenCalledWith(expect.objectContaining({ profile: 'legacy' }))
+})
