@@ -0,0 +1,61 @@
+import { act, render, screen } from '@testing-library/react'
+import { atom } from 'nanostores'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { ComposerScopeProvider, MAIN_COMPOSER_SCOPE } from '@/app/chat/composer/scope'
+import { PaneVisibleContext } from '@/components/pane-shell/pane-visibility'
+import { registry } from '@/contrib/registry'
+
+import { ComposerContributionSlot, usePluginComposerContext } from './composer-context'
+
+const stored = atom<string | null>('saved')
+vi.mock('@/app/chat/session-view', () => ({ useSessionView: () => ({ $storedId: stored }) }))
+const disposers: (() => void)[] = []
+afterEach(() => {
+  disposers.splice(0).forEach(fn => fn())
+  stored.set('saved')
+})
+
+function Probe() {
+  return <output>{JSON.stringify(usePluginComposerContext())}</output>
+}
+
+function mountSlot(connectionId?: string, profile?: string, visible = true) {
+  return (
+    <ComposerScopeProvider value={{ ...MAIN_COMPOSER_SCOPE, connectionId, profile }}>
+      <PaneVisibleContext.Provider value={visible}>
+        <ComposerContributionSlot area="composer.top" />
+      </PaneVisibleContext.Provider>
+    </ComposerScopeProvider>
+  )
+}
+
+it('projects each composer owner independently rather than the focused window owner', () => {
+  disposers.push(registry.register({ id: 'probe', area: 'composer.top', render: () => <Probe /> }))
+
+  const view = render(
+    <>
+      {mountSlot('one', 'work')}
+      {mountSlot('two', 'work')}
+    </>
+  )
+
+  expect(screen.getAllByRole('status').map(el => JSON.parse(el.textContent!))).toEqual([
+    { storedSessionId: 'saved', connectionId: 'one', profile: 'work', visible: true },
+    { storedSessionId: 'saved', connectionId: 'two', profile: 'work', visible: true }
+  ])
+  view.rerender(mountSlot('one', 'work', false))
+  expect(JSON.parse(screen.getByRole('status').textContent!).visible).toBe(false)
+  act(() => stored.set(null))
+  expect(screen.getByRole('status').textContent).toBe('null')
+})
+it('returns null outside the contribution or with incomplete owner, never ambient fallback', () => {
+  disposers.push(registry.register({ id: 'probe', area: 'composer.top', render: () => <Probe /> }))
+  render(
+    <>
+      <Probe />
+      {mountSlot(undefined, 'work')}
+    </>
+  )
+  expect(screen.getAllByRole('status').map(el => el.textContent)).toEqual(['null', 'null'])
+})
diff --git a/apps/desktop/src/sdk/composer-context.tsx b/apps/desktop/src/sdk/composer-context.tsx
new file mode 100644
index 00000000000..4b12ea96c50
--- /dev/null
+++ b/apps/desktop/src/sdk/composer-context.tsx
@@ -0,0 +1,43 @@
+import { useStore } from '@nanostores/react'
+import { createContext, useContext, useMemo } from 'react'
+
+import { useComposerScope } from '@/app/chat/composer/scope'
+import { useSessionView } from '@/app/chat/session-view'
+import { useTranscriptWindow } from '@/components/assistant-ui/thread/transcript-window'
+import { usePaneVisible } from '@/components/pane-shell/pane-visibility'
+import { Slot, type SlotProps } from '@/contrib/react/slot'
+
+/** The exact existing conversation owning a composer contribution, never window focus. */
+export interface PluginComposerContext {
+  storedSessionId: string
+  connectionId: string
+  profile: string
+  visible: boolean
+}
+
+const Context = createContext<PluginComposerContext | null>(null)
+
+/** Null outside a composer contribution, on drafts, or while ownership is unresolved. */
+export const usePluginComposerContext = (): PluginComposerContext | null => useContext(Context)
+
+/** Host-only boundary: do not export this provider through the plugin SDK. */
+export function ComposerContributionSlot(props: SlotProps) {
+  const scope = useComposerScope()
+  const storedSessionId = useStore(useSessionView().$storedId)
+  const paneVisible = usePaneVisible()
+  const { isHistorical } = useTranscriptWindow()
+  const connectionId = scope.connectionId
+  const profile = scope.profile
+  const visible = paneVisible && !isHistorical
+
+  const value = useMemo<PluginComposerContext | null>(
+    () => (storedSessionId && connectionId && profile ? { storedSessionId, connectionId, profile, visible } : null),
+    [storedSessionId, connectionId, profile, visible]
+  )
+
+  return (
+    <Context.Provider value={value}>
+      <Slot {...props} />
+    </Context.Provider>
+  )
+}
