+"""Existing-grant mode against the real SDK with synthetic temp stores and HTTP only.
+
+The shared fixture forbids sockets/default HTTP; the runner also blocks DNS from
+collection onward. No installed profile, credentials or network is involved.
+"""
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import httpx2 as httpx
+import pytest
+from mcp.shared.auth import OAuthClientInformationFull, OAuthClientMetadata, OAuthMetadata, OAuthToken
+
+from tests.tools.test_mcp_oauth_discovery_client import AUTH, RESOURCE, Operation, fake_manager_dependencies, response
+from tests.tools.test_mcp_oauth_discovery_client import no_network_or_default_client as no_network_or_default_client
+from tools.mcp_oauth import HermesTokenStorage, acquire_refresh_fence, release_refresh_fence
+from tools.mcp_oauth_manager import (
+    HermesMCPOAuthProvider, MCPOAuthManager, OAuthExistingCredentialsRequired, OAuthOperationCleanupError,
+)
+from tools.mcp_oauth_provider import HermesProviderMixin
+
+
+async def prepared(tmp_path, monkeypatch, *, ttl=3600, token=True, refresh=True, client=True,
+                   token_issuer=AUTH, client_issuer=AUTH, op=None, cimd=None):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    store = HermesTokenStorage("existing-synthetic")
+    store.bind_issuer(token_issuer)
+    if token:
+        await store.set_tokens(OAuthToken(
+            access_token="synthetic-access-v1", refresh_token="synthetic-refresh-v1" if refresh else None,
+            token_type="Bearer", expires_in=ttl, scope="read"))
+    if client:
+        await store.set_client_info(OAuthClientInformationFull(
+            client_id="synthetic-existing-client", issuer=client_issuer,
+            redirect_uris=["http://127.0.0.1/callback"], token_endpoint_auth_method="none"))
+    op = op or Operation()
+    p = HermesMCPOAuthProvider(
+        server_name="existing-synthetic", server_url=RESOURCE, storage=store,
+        client_metadata=OAuthClientMetadata(redirect_uris=["http://127.0.0.1/callback"], scope="read"),
+        redirect_handler=AsyncMock(), callback_handler=AsyncMock(), client_metadata_url=cimd,
+        metadata_client_factory=op.factory, existing_credentials_only=True,
+    )
+    for name in ("set_tokens", "set_client_info"):
+        monkeypatch.setattr(store, name, AsyncMock(wraps=getattr(store, name)))
+    for name in ("strip_refresh_token", "stamp_issuer", "poison_client_registration", "mark_cimd_rejected"):
+        monkeypatch.setattr(store, name, Mock(wraps=getattr(store, name)))
+    return p, store, op
+
+
+async def locks_released(p, store):
+    await asyncio.wait_for(p.context.lock.acquire(), 5)
+    p.context.lock.release()
+    assert p._hermes_fence is None
+    fd = await acquire_refresh_fence(store._tokens_path(), timeout=0.1)
+    release_refresh_fence(fd)
+
+
+def no_new_authorization(p, store):
+    p.context.redirect_handler.assert_not_awaited()
+    p.context.callback_handler.assert_not_awaited()
+    store.set_client_info.assert_not_awaited()
+    store.strip_refresh_token.assert_not_called()
+    store.stamp_issuer.assert_not_called()
+    store.poison_client_registration.assert_not_called()
+    store.mark_cimd_rejected.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_valid_existing_token_fresh_metadata_no_registration(tmp_path, monkeypatch):
+    p, store, op = await prepared(tmp_path, monkeypatch)
+    sent = []
+
+    def handler(request):
+        sent.append(str(request.url))
+        assert request.headers["authorization"] == "Bearer synthetic-access-v1"
+        return httpx.Response(200, json={"synthetic": True})
+
+    async with httpx.AsyncClient(auth=p, transport=httpx.MockTransport(handler)) as client:
+        assert (await client.get(RESOURCE)).status_code == 200
+    assert sent == [RESOURCE] and len(op.sent) == 2
+    store.set_tokens.assert_not_awaited()
+    no_new_authorization(p, store)
+    await locks_released(p, store)
+
+
+@pytest.mark.asyncio
+async def test_existing_refresh_saved_once_without_scope_change(tmp_path, monkeypatch):
+    p, store, op = await prepared(tmp_path, monkeypatch, ttl=0)
+    sent = []
+
+    def handler(request):
+        sent.append(str(request.url))
+        if request.url.path == "/token":
+            assert b"grant_type=refresh_token" in request.content and b"scope=" not in request.content
+            return httpx.Response(200, json={
+                "access_token": "synthetic-access-v2", "refresh_token": "synthetic-refresh-v2",
+                "token_type": "Bearer", "expires_in": 3600})
+        assert request.headers["authorization"] == "Bearer synthetic-access-v2"
+        return httpx.Response(200, json={"synthetic": True})
+
+    async with httpx.AsyncClient(auth=p, transport=httpx.MockTransport(handler)) as client:
+        await client.get(RESOURCE)
+    assert sent == [AUTH + "/token", RESOURCE] and len(op.sent) == 2
+    store.set_tokens.assert_awaited_once()
+    saved = await store.get_tokens()
+    assert (saved.access_token, saved.refresh_token, saved.scope) == (
+        "synthetic-access-v2", "synthetic-refresh-v2", "read")
+    assert store.loaded_issuer == AUTH
+    no_new_authorization(p, store)
+    await locks_released(p, store)
+
