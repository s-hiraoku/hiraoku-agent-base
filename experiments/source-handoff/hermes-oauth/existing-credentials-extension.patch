+        if failure == "invalid_client":
+            return httpx.Response(400, json={"error": "invalid_client"})
+        if failure == "server_error":
+            return httpx.Response(500)
+        if failure == "invalid_json":
+            return httpx.Response(200, content=b"invalid")
+        return httpx.Response(200, json={"access_token": "synthetic-wide", "token_type": "Bearer",
+                                         "expires_in": 3600, "scope": "read admin"})
+
+    async with httpx.AsyncClient(auth=p, transport=httpx.MockTransport(handler)) as client:
+        with pytest.raises((OAuthExistingCredentialsRequired, httpx.ReadTimeout)):
+            await client.get(RESOURCE)
+        with pytest.raises(OAuthExistingCredentialsRequired, match="discard"):
+            await client.get(RESOURCE)
+    assert sent == [AUTH + "/token"] and len(op.sent) == 2
+    store.set_tokens.assert_not_awaited()
+    no_new_authorization(p, store)
+    await locks_released(p, store)
+
