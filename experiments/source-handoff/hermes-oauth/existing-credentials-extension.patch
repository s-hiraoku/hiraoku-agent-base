+@pytest.mark.asyncio
+async def test_cleanup_failure_propagates_terminal_baseexception(tmp_path, monkeypatch):
+    p, store, _ = await prepared(tmp_path, monkeypatch)
+    original_flow = HermesProviderMixin.async_auth_flow
+
+    class FailingClose:
+        def __init__(self, inner):
+            self.inner = inner
+
+        async def __anext__(self):
+            return await self.inner.__anext__()
+
+        async def asend(self, value):
+            return await self.inner.asend(value)
+
+        async def aclose(self):
+            await self.inner.aclose()
+            raise RuntimeError("synthetic cleanup failure")
+
+    monkeypatch.setattr(HermesProviderMixin, "async_auth_flow", lambda self, request: FailingClose(original_flow(self, request)))
+    async with httpx.AsyncClient(auth=p, transport=httpx.MockTransport(lambda r: httpx.Response(200))) as client:
+        with pytest.raises(OAuthOperationCleanupError, match="cleanup is uncertain"):
+            await client.get(RESOURCE)
+        with pytest.raises(OAuthExistingCredentialsRequired, match="discard"):
+            await client.get(RESOURCE)
+    assert not issubclass(OAuthOperationCleanupError, Exception)
+    no_new_authorization(p, store)
+
