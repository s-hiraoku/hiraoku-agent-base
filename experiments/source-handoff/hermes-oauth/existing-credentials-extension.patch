+
+    op = Operation(metadata)
+    p, store, _ = await prepared(
+        tmp_path, monkeypatch, client=False, op=op,
+        cimd="https://client.example/metadata.json" if challenge == "cimd" else None)
+    sent = []
+
+    def handler(request):
+        sent.append(str(request.url))
+        return httpx.Response(403 if challenge in ("scope", "forbidden") else 401,
+                              headers={"WWW-Authenticate": 'Bearer error="insufficient_scope", scope="admin"'})
+
+    async with httpx.AsyncClient(auth=p, transport=httpx.MockTransport(handler)) as client:
+        with pytest.raises(OAuthExistingCredentialsRequired, match="rejected"):
+            await client.get(RESOURCE)
+        with pytest.raises(OAuthExistingCredentialsRequired, match="discard"):
+            await client.get(RESOURCE)
+    assert sent == [RESOURCE] and len(op.sent) == 2
+    assert p.context.client_metadata.scope == "read"
+    store.set_tokens.assert_not_awaited()
+    no_new_authorization(p, store)
+    await locks_released(p, store)
