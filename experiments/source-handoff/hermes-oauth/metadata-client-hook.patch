+@pytest.mark.asyncio
+@pytest.mark.parametrize("invalid", ["resource", "issuer"])
+async def test_guarded_discovery_enforces_sdk_resource_and_issuer(invalid):
+    from mcp.client.auth.oauth2 import OAuthFlowError
+
+    def mismatched(request):
+        result = response(request)
+        value = result.json()
+        if invalid == "resource" and "resource" in value:
+            value["resource"] = "https://unrelated.example/mcp"
+        if invalid == "issuer" and "issuer" in value:
+            value["issuer"] = "https://unexpected-issuer.example"
+        return httpx.Response(200, json=value)
+
+    op = Operation(mismatched)
+    p = provider(op.factory)
+    with pytest.raises(OAuthFlowError, match="match"):
+        await p._initialize()
+    assert len(op.sent) == (1 if invalid == "resource" else 2)
+    assert p.context.protected_resource_metadata is None
+    assert p.context.auth_server_url is None and p.context.oauth_metadata is None
+    with pytest.raises(RuntimeError, match="discard this provider"):
+        await p._initialize()
+    assert op.closed == 1
