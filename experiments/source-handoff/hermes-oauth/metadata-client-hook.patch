+@pytest.mark.asyncio
+async def test_denial_before_first_discovery_and_repeated_use():
+    op = Operation()
+    op.active = False
+    p = provider(op.factory)
+    with pytest.raises(PermissionError, match="operation denied"):
+        await p._initialize()
+    with pytest.raises(RuntimeError, match="discard this provider"):
+        await p._initialize()
+    assert p._initialized is False
+    assert not op.sent and op.closed == 1
+
