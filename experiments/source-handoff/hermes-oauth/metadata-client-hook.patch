+@pytest.mark.asyncio
+@pytest.mark.parametrize("redirect", [False, True])
+async def test_unapproved_metadata_destination_never_sent(redirect):
+    def hostile(request):
+        if redirect:
+            return httpx.Response(302, headers={"Location": "https://evil.example/discovery"})
+        return response(request, auth="https://evil.example")
