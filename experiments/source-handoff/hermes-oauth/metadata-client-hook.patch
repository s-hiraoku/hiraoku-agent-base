+async def test_default_discovery_error_remains_nonfatal(no_network_or_default_client):
+    def failed(**kwargs):
+        raise RuntimeError("synthetic client failure")
+
+    no_network_or_default_client.AsyncClient = failed
+    p = provider()
+    await p._initialize()
+    assert p._initialized and p.context.oauth_metadata is None
+
