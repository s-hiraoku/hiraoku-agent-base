+@pytest.mark.asyncio
+async def test_pause_after_prm_prevents_asm_send():
+    op = Operation()
+
+    def pause(request):
+        result = response(request)
+        op.active = False
+        return result
+
+    op.handler = pause
+    p = provider(op.factory)
+    with pytest.raises(PermissionError):
+        await p._initialize()
+    assert len(op.sent) == 1 and "oauth-protected-resource" in op.sent[0]
+    assert len(op.denied) == 1 and "oauth-authorization-server" in op.denied[0]
+    assert p._initialized is False and p.context.oauth_metadata is None and op.closed == 1
+
