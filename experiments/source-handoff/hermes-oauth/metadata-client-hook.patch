+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", [RuntimeError, httpx.ConnectError])
+async def test_errors_propagate_without_retry_or_logging(failure, caplog):
+    def fail(request):
+        raise failure("synthetic-secret-must-not-be-logged")
+
+    op = Operation(fail)
+    p = provider(op.factory)
+    caplog.set_level(logging.DEBUG, logger=manager_module.__name__)
