+@pytest.mark.asyncio
+async def test_storage_failure_makes_guarded_provider_terminal(monkeypatch):
+    op = Operation()
+    p = provider(op.factory)
+    writes = []
+
+    def uncertain_write(metadata):
+        writes.append(metadata)
+        raise OSError("synthetic storage write failure")
+
+    monkeypatch.setattr(p, "_hermes_storage", lambda: SimpleNamespace(save_oauth_metadata=uncertain_write))
+    with pytest.raises(OSError):
+        await p._initialize()
+    assert not p._initialized and p.context.oauth_metadata is None
+    with pytest.raises(RuntimeError, match="discard this provider"):
+        await p._initialize()
+    assert len(writes) == 1 and op.closed == 1
