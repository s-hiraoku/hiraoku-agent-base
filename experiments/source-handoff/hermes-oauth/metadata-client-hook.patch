+@pytest.mark.asyncio
+async def test_exit_failure_never_publishes_or_persists_metadata(tmp_path, monkeypatch):
+    from tools.mcp_oauth import HermesTokenStorage
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    store = HermesTokenStorage("synthetic")
+    await store.set_tokens(OAuthToken(
+        access_token="synthetic-access-only", token_type="Bearer", expires_in=3600))
+    op = Operation()
+    factory_calls = []
+
+    @asynccontextmanager
+    async def denied_on_exit():
+        factory_calls.append(True)
+        async with op.factory() as client:
+            yield client
+        raise PermissionError("synthetic settle refusal")
+
+    p = provider(denied_on_exit)
+    p.context.storage = store
+    with pytest.raises(PermissionError):
+        await p._initialize()
+    assert store.load_oauth_metadata() is None
+    assert p.context.oauth_metadata is None and p.context.protected_resource_metadata is None
+    with pytest.raises(RuntimeError, match="discard this provider"):
+        await p._initialize()
+    assert len(factory_calls) == 1
+    # A fresh provider must not find metadata left on disk by the failed one.
+    op.active = False
+    fresh = provider(op.factory)
+    fresh.context.storage = store
+    with pytest.raises(PermissionError):
+        await fresh._initialize()
+    assert len(op.sent) == 2 and len(op.denied) == 1
+
