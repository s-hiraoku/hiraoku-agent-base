+@pytest.mark.asyncio
+async def test_factory_exit_guard_failure_is_fatal():
+    op = Operation()
+
+    @asynccontextmanager
+    async def denied_on_exit():
+        async with op.factory() as client:
+            yield client
+        raise PermissionError("operation expired at settle")
+
+    p = provider(denied_on_exit)
+    with pytest.raises(PermissionError):
+        await p._initialize()
+    assert p._initialized is False and op.closed == 1
