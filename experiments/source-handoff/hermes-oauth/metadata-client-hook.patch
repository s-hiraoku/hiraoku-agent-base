+@pytest.mark.asyncio
+async def test_cancel_waits_for_cleanup_without_fallback():
+    admitted, cleaning, finish = asyncio.Event(), asyncio.Event(), asyncio.Event()
+    op = Operation()
+
+    async def waiting(request):
+        admitted.set()
+        await asyncio.Event().wait()
+
+    op.handler = waiting
+
+    @asynccontextmanager
+    async def factory():
+        try:
+            async with op.factory() as client:
+                yield client
+        finally:
+            cleaning.set()
+            await finish.wait()
+
+    p = provider(factory)
+    task = asyncio.create_task(p._initialize())
+    await asyncio.wait_for(admitted.wait(), 5)
+    task.cancel()
+    await asyncio.wait_for(cleaning.wait(), 5)
+    assert not task.done() and len(op.sent) == 1
+    finish.set()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+    assert p._initialized is False and op.closed == 1
+
