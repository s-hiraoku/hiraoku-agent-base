+@pytest.mark.asyncio
+async def test_guarded_origin_issued_exception_does_not_accept_redirect():
+    from mcp.client.auth.oauth2 import OAuthFlowError
+
+    def redirected(request):
+        if request.url.path == "/.well-known/oauth-authorization-server/tenant":
+            return httpx.Response(302, headers={"Location": AUTH + "/elsewhere"})
+        return response(request, auth=AUTH + "/tenant")
+
+    op = Operation(redirected, follow_redirects=True)
+    p = provider(op.factory)
+    with pytest.raises(OAuthFlowError, match="issuer mismatch"):
+        await p._initialize()
+    assert p.context.oauth_metadata is None
