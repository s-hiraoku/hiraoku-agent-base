+"""Real provider discovery with synthetic storage and MockTransport, never live I/O."""
+import asyncio
+from contextlib import asynccontextmanager
+import logging
+import socket
+import sys
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+import httpx2 as httpx
+from mcp.shared.auth import OAuthClientMetadata, OAuthToken
+from tools import mcp_oauth_manager as manager_module
+from tools.mcp_oauth_manager import HermesMCPOAuthProvider, MCPOAuthManager
+
+RESOURCE = "https://resource.example/mcp"
+AUTH = "https://auth.example"
+
+
+@pytest.fixture(autouse=True)
+def no_network_or_default_client(monkeypatch):
+    original_connect = socket.socket.connect
+
+    def reject_network(sock, *args):
+        if sock.family in (socket.AF_INET, socket.AF_INET6):
+            raise AssertionError("network forbidden in synthetic tests")
+        return original_connect(sock, *args)
+
+    monkeypatch.setattr(socket.socket, "connect", reject_network)
+
+    def default_forbidden(**kwargs):
+        raise AssertionError("unguarded metadata client constructed")
+
+    sdk = SimpleNamespace(HTTPError=httpx.HTTPError, AsyncClient=default_forbidden)
+    monkeypatch.setitem(sys.modules, "tools.mcp_tool", SimpleNamespace(sdk_httpx=lambda: sdk))
+    return sdk
+
+
+def storage():
+    return SimpleNamespace(
+        get_tokens=AsyncMock(return_value=OAuthToken(
+            access_token="synthetic-access-only", token_type="Bearer", expires_in=3600)),
+        get_client_info=AsyncMock(return_value=None),
+        set_tokens=AsyncMock(), set_client_info=AsyncMock(),
+    )
+
+
+def provider(factory=None):
+    return HermesMCPOAuthProvider(
+        server_name="synthetic", server_url=RESOURCE,
+        client_metadata=OAuthClientMetadata(redirect_uris=["http://127.0.0.1/callback"]),
+        storage=storage(), redirect_handler=AsyncMock(), callback_handler=AsyncMock(),
+        metadata_client_factory=factory,
+    )
+
+
+def response(request, auth=AUTH):
+    if "oauth-protected-resource" in request.url.path:
+        return httpx.Response(200, json={"resource": RESOURCE, "authorization_servers": [auth]})
+    return httpx.Response(200, json={
+        "issuer": AUTH, "authorization_endpoint": AUTH + "/authorize",
+        "token_endpoint": AUTH + "/token", "response_types_supported": ["code"],
+    })
+
+
+class Operation:
+    def __init__(self, handler=None, *, follow_redirects=False):
+        self.active = True
+        self.sent = []
+        self.denied = []
+        self.open = 0
+        self.closed = 0
+        self.handler = handler or response
+        self.follow_redirects = follow_redirects
+
+    async def send(self, request):
+        if not self.active or (request.url.scheme, request.url.host) not in {
+            ("https", "resource.example"), ("https", "auth.example")
+        }:
+            self.denied.append(str(request.url))
+            raise PermissionError("operation denied")
+        assert not request.headers.get("authorization")
+        assert not request.headers.get("cookie")
+        self.sent.append(str(request.url))
+        result = self.handler(request)
+        return await result if hasattr(result, "__await__") else result
+
+    @asynccontextmanager
+    async def factory(self):
+        self.open += 1
+        try:
+            async with httpx.AsyncClient(
+                transport=httpx.MockTransport(self.send), auth=None,
+                follow_redirects=self.follow_redirects, trust_env=False, timeout=10,
+            ) as client:
+                yield client
+        finally:
+            self.open -= 1
+            self.closed += 1
+
+
+@pytest.mark.asyncio
+async def test_actual_initialize_scoped_factory_without_credentials(caplog):
+    op = Operation()
+    p = provider(op.factory)
+    caplog.set_level(logging.DEBUG, logger=manager_module.__name__)
+    await p._initialize()
+    assert len(op.sent) == 2
+    assert p.context.auth_server_url == AUTH
+    assert str(p.context.oauth_metadata.token_endpoint) == AUTH + "/token"
+    assert p._initialized and op.open == 0 and op.closed == 1
+    assert "synthetic-access-only" not in caplog.text
+    assert AUTH + "/token" not in caplog.text
+
+
+@pytest.mark.asyncio
+async def test_default_factory_preserves_client_arguments(no_network_or_default_client):
+    calls = []
+
+    def default_client(**kwargs):
+        calls.append(kwargs)
+        return httpx.AsyncClient(transport=httpx.MockTransport(response), **kwargs)
+
+    no_network_or_default_client.AsyncClient = default_client
+    p = provider()
+    await p._initialize()
+    assert calls == [{"timeout": 10.0}] and p.context.oauth_metadata is not None
+
