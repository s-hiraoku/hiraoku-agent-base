+    a, b = Operation(), Operation()
+    pa = m.get_or_build_provider("synthetic", RESOURCE, {}, metadata_client_factory=a.factory)
+    pb = m.get_or_build_provider("synthetic", RESOURCE, {}, metadata_client_factory=b.factory)
