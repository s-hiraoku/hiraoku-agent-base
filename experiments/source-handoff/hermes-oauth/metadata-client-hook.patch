+    monkeypatch.setattr(shared, "build_provider_kwargs", lambda cfg, store, **kw: {
+        "storage": store,
+        "client_metadata": OAuthClientMetadata(redirect_uris=["http://127.0.0.1/callback"]),
+        "redirect_handler": AsyncMock(), "callback_handler": AsyncMock(),
