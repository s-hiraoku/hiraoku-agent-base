{
  "name": "agent-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo:hab-enrollment": "node scripts/hab-enrollment-demo.mjs",
    "test:hab-integration": "node --test test/hab-enrollment-delivery.test.js",
    "test": "npm run build && node --test test/*.test.js",
    "check": "tsc --noEmit",
    "lint": "eslint src db test scripts/hab-mvp-demo.mjs scripts/lib/local-mvp.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "schema:generate": "drizzle-kit generate",
    "demo:hab-mvp": "node scripts/hab-mvp-demo.mjs",
    "test:hab-mvp": "node --test test/local-mvp.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@modelcontextprotocol/server": "2.3.1",
    "drizzle-orm": "^0.45.3",
    "ipaddr.js": "^2.5.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
